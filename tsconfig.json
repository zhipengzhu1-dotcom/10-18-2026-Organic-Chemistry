{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["content/src", "content/test", "site/src/engine", "site/src/components", "site/src/lib", "site/src/tutor", "site/src/styles", "site/src/submissions", "site/functions", "site/e2e", "playwright.config.ts", "scenes/src", "scenes/test", "video/src", "pipelines/blender"]
}
