{
  "name": "astratron",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "content:build": "pnpm --filter @astratron/content run build",
    "lint:numbers": "pnpm --filter @astratron/content run lint:numbers",
    "dev": "pnpm --filter @astratron/site run dev",
    "build": "pnpm --filter @astratron/site run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
