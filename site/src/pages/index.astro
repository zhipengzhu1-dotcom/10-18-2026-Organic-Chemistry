---
// Home page. First-time visitors get the Push hero (#73): the headline, a live
// OH⁻ + H⁺ push and one "Start Unit 1" button, with the Course map right below.
// Returning visitors get the Hub instead: a Continue card and the Streak. Both
// see the Course map and can export or import their progress.
import Base from "../layouts/Base.astro";
import CourseMap from "../components/CourseMap.astro";
import Preferences from "../components/Preferences.astro";
import TopBar from "../components/TopBar.astro";
import PushHero from "../components/PushHero.tsx";
import { courseModel } from "../lib/content.ts";
import type { CatalogLesson } from "../progress/hub.ts";

const { subjects } = courseModel();
const HEADLINE = "Chemistry is how the universe builds things. Come build.";
const hero = subjects.find((s) => s.hero)?.hero;
/** Unit 1: the first available Unit of the first Course. */
const unit1 = subjects[0]?.courses[0]?.units.find((u) => u.status === "available");
/** Every playable Lesson in Course order, for the Continue card. */
const catalog: CatalogLesson[] = subjects.flatMap((s) =>
  s.courses.flatMap((c) =>
    c.units
      .filter((u) => u.status === "available")
      .flatMap((u) =>
        u.lessons.map((l) => ({
          id: l.id,
          title: l.title,
          url: l.url,
          unit: `Unit ${u.number} · ${u.title}`,
          steps: l.steps.map((step) => step.id),
          onRamp: l.onRamp,
        })),
      ),
  ),
);
---

<Base title="AstraTron" description="Free, interactive organic chemistry: move electrons and build molecules, one Step at a time. No ads, no sign-up.">
  <script is:inline>
    // Decide first-time vs returning before the page paints, so neither view flashes.
    try {
      if (JSON.parse(localStorage.getItem("astratron.progress") ?? "{}").last) document.documentElement.classList.add("returning");
    } catch {}
  </script>
  <TopBar />
  <main class="page">
    <section class="hub" aria-labelledby="hub-title">
      <h1 id="hub-title">Welcome back</h1>
      <p data-streak-text>Streak: 0 days</p>
      <section class="continue-card" aria-label="Continue">
        <p class="continue-unit" data-continue="unit"></p>
        <h2 data-continue="title"></h2>
        <p data-continue="where"></p>
        <a class="btn btn-primary" data-continue="link" href="/">Resume</a>
      </section>
    </section>

    <div class="first-visit">
      <section class="push-hero-screen" aria-label={HEADLINE}>
        <h1 class="hero-title">Chemistry is how the universe builds things. <span class="hero-accent">Come build.</span></h1>
        {hero && <PushHero client:load task={hero} />}
        {unit1 && <a class="btn btn-primary btn-block" href={unit1.url}>Start Unit 1 ▸</a>}
      </section>
    </div>

    {subjects.map((subject) => <CourseMap subject={subject} />)}

    <section class="your-progress" aria-labelledby="your-progress">
      <h2 id="your-progress">Your progress</h2>
      <p>Your progress stays in this browser. Export it to a file to carry it to another browser.</p>
      <button type="button" class="btn btn-secondary" data-export>Export progress</button>
      <label class="import">
        Import progress
        <input type="file" accept="application/json,.json" data-import />
      </label>
      <p role="alert" data-import-error></p>
    </section>

    <Preferences />
  </main>
  <script type="application/json" id="lesson-catalog" set:html={JSON.stringify(catalog)} />
</Base>

<script>
  import { showHub, showStreak, wireExportImport } from "../progress/pages.ts";
  showHub(JSON.parse(document.getElementById("lesson-catalog")!.textContent!));
  showStreak();
  wireExportImport();
</script>
