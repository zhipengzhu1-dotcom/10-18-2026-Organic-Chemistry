---
// Placeholder home page: the Course map of every Subject. The Push hero (#73)
// goes above it.
import Base from "../layouts/Base.astro";
import CourseMap from "../components/CourseMap.astro";
import Preferences from "../components/Preferences.astro";
import { courseModel } from "../lib/content.ts";

const { subjects } = courseModel();
---

<Base title="AstraTron">
  <main class="page">
    <h1 class="wordmark">AstraTron</h1>
    <p>Move electrons. Move the world.</p>
    {subjects.map((subject) => <CourseMap subject={subject} />)}
    <Preferences />
  </main>
</Base>

