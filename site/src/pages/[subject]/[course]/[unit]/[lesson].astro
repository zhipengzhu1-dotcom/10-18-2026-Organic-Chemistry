---
import type { GetStaticPaths } from "astro";
import Base from "../../../../layouts/Base.astro";
import StepPlayer from "../../../../components/StepPlayer.tsx";
import { answerKeyUrl, lessonPages, renderLesson, type LessonPage } from "../../../../lib/content.ts";
import { splitLesson } from "../../../../lib/answer-key.ts";

export const getStaticPaths = (() =>
  lessonPages().map((page) => ({
    params: { subject: page.subject, course: page.course, unit: page.unit, lesson: page.lesson.slug },
    props: page,
  }))) satisfies GetStaticPaths;

const { subject, lesson, unitId, unitTitle, unitUrl } = Astro.props as LessonPage;
// Only what a Student sees before answering goes into the page; the answer key is its own file.
const { page } = splitLesson(renderLesson(lesson));
---

<Base title={`${lesson.title} · ${unitTitle} · AstraTron`} description={lesson.goal} bare>
  <StepPlayer client:load lesson={page} keyUrl={answerKeyUrl(subject, lesson.id)} exitHref={unitUrl} unitId={unitId} />
</Base>
