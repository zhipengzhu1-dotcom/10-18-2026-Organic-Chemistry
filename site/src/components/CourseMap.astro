---
// The Course map: each Course of a Subject as a horizontal strip of Unit tiles.
// Available Units link to their Level select page; coming-soon Units show their
// title but can't be entered. Placeholder styles until the design system (#59).
import type { Subject } from "@astratron/content";

interface Props {
  subject: Subject;
}
const { subject } = Astro.props;
---

<div class="course-map">
  {
    subject.courses.map((course) => (
      <section class="course" aria-labelledby={`course-${course.slug}`}>
        <h2 id={`course-${course.slug}`}>{course.title}</h2>
        <ol class="tiles">
          {course.units.map((unit) => (
            <li class:list={["tile", unit.status === "available" ? "open" : "soon"]}>
              {unit.status === "available" ? (
                <a href={unit.url}>
                  <span class="tile-number">Unit {unit.number}</span>
                  <span class="tile-title">{unit.title}</span>
                  {unit.summary && <span class="tile-summary">{unit.summary}</span>}
                </a>
              ) : (
                <div>
                  <span class="tile-number">Unit {unit.number}</span>
                  <span class="tile-title">{unit.title}</span>
                  {unit.summary && <span class="tile-summary">{unit.summary}</span>}
                  <span class="tile-soon">Coming soon</span>
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .course-map { display: grid; gap: 1.5rem; }
  .course h2 { margin: 0 0 0.5rem; }
  .tiles {
    display: flex; gap: 0.75rem; overflow-x: auto; list-style: none; margin: 0; padding: 0 0 0.75rem;
    scroll-snap-type: x proximity;
  }
  .tile { flex: 0 0 12rem; scroll-snap-align: start; border: 2px solid #8b7bff; background: #1b1840; }
  .tile > a, .tile > div { display: flex; flex-direction: column; gap: 0.25rem; height: 100%; padding: 0.75rem; box-sizing: border-box; color: inherit; text-decoration: none; }
  .tile.open { border-color: #5ee7ff; box-shadow: 4px 4px 0 #8b7bff; }
  .tile.soon { border-style: dashed; opacity: 0.8; }
  .tile-number, .tile-soon { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .tile-title { font-weight: 700; }
  .tile-summary { font-size: 0.9rem; opacity: 0.85; }
  .tile-soon { margin-top: auto; color: #ff9d3c; }
</style>
