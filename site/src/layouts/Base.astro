---
import "../styles/global.css";
import { suggestProblemHref } from "../lib/submit-links.ts";

interface Props {
  title: string;
  description?: string;
  /** A Lesson page: the full-screen Step player, with no footer (nothing pulls a Student out of a Lesson). */
  bare?: boolean;
}
const { title, description, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-motion="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!--
      Theme and motion before first paint. The site's switches (Preferences.astro)
      store `at-theme` (dark | light) and `at-motion` (reduced) in localStorage;
      with nothing stored the OS setting decides. Reduced motion is on if either says so.
    -->
    <script is:inline>
      (() => {
        const read = (k) => {
          try {
            return localStorage.getItem(k);
          } catch {
            return null;
          }
        };
        const os = (q) => matchMedia(q).matches;
        const root = document.documentElement;
        const theme = read("at-theme");
        root.dataset.theme = theme === "light" || theme === "dark" ? theme : os("(prefers-color-scheme: light)") ? "light" : "dark";
        root.dataset.motion = read("at-motion") === "reduced" || os("(prefers-reduced-motion: reduce)") ? "reduced" : "full";
      })();
    </script>
  </head>
  <body>
    <slot />
    {
      !bare && (
        <footer class="site-footer">
          {/* #77 adds the Donate line, licences, credits and the privacy link. */}
          <a href={suggestProblemHref()}>Suggest a Problem</a>
        </footer>
      )
    }
  </body>
</html>
