---
import "../styles/global.css";
import { suggestProblemHref } from "../lib/submit-links.ts";
import { KOFI_URL, pageMeta, robots } from "../lib/site.ts";

interface Props {
  title: string;
  description?: string;
  /** A Lesson page: the full-screen Step player, with no footer (nothing pulls a Student out of a Lesson). */
  bare?: boolean;
  /** The Unit this page belongs to, if any: Unit 1 pages share the Unit 1 image. */
  unitId?: string;
}
const { title, description, bare = false, unitId } = Astro.props;
// Canonical URL and share image come from the one site-address setting (lib/site.ts).
const meta = pageMeta({ path: Astro.url.pathname, unitId });
/** One fixed turbulence seed per boil frame: filters boil-0, boil-1, boil-2. */
const BOIL_SEEDS = [11, 27, 45];
---

<!doctype html>
<html lang="en" data-motion="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Nothing is indexed until the owner goes public: PUBLIC in lib/site.ts (pre-public checklist). -->
    {robots() && <meta name="robots" content={robots()} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={meta.canonical} />
    <!-- The icon, from the repo's "AstraTron Icon.jpg" (sips -z 32 32 / 180 180). -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:site_name" content="AstraTron" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.image.url} />
    <meta property="og:image:type" content={meta.image.type} />
    <meta property="og:image:width" content={String(meta.image.width)} />
    <meta property="og:image:height" content={String(meta.image.height)} />
    <meta property="og:image:alt" content={meta.image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={meta.image.url} />
    <meta name="twitter:image:alt" content={meta.image.alt} />
    <!--
      Motion before first paint. The site's switch (Preferences.astro) stores `at-motion`
      (reduced) in localStorage; reduced motion is on if it or the OS says so.
      There is one theme (paper): a stored `at-theme` from the old site is ignored.
    -->
    <script is:inline>
      (() => {
        const read = (k) => {
          try {
            return localStorage.getItem(k);
          } catch {
            return null;
          }
        };
        const os = (q) => matchMedia(q).matches;
        const root = document.documentElement;
        root.dataset.motion = read("at-motion") === "reduced" || os("(prefers-reduced-motion: reduce)") ? "reduced" : "full";
      })();
    </script>
  </head>
  <body>
    <!--
      Pen-line wobble for Scene drawings (ScenePlayer sets it on the drawing's wrapper): `rough` is
      the static wobble on a stopped Scene; while one plays, its lines boil through boil-0/1/2, one
      seed per 20 fps frame. Seeds are fixed. Values from the prototype (spec #117).
    -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="rough" filterUnits="userSpaceOnUse" x="-500" y="-500" width="3000" height="2200">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="3" />
        <feDisplacementMap in="SourceGraphic" scale="2.6" />
      </filter>
      {
        BOIL_SEEDS.map((seed, i) => (
          <filter id={`boil-${i}`} filterUnits="userSpaceOnUse" x="-500" y="-500" width="3000" height="2200">
            <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed={seed} />
            <feDisplacementMap in="SourceGraphic" scale="3.2" />
          </filter>
        ))
      }
    </svg>
    <slot />
    {
      !bare && (
        <footer class="site-footer">
          <p class="motto">Move electrons. Move the world.</p>
          <p>
            AstraTron is free, with no ads and no sign-up. If it helped you, you can <a href={KOFI_URL}>chip in on Ko-fi</a>. AstraTron
            isn't a registered charity, so donations aren't tax-deductible.
          </p>
          <p>
            Code: <a href="https://opensource.org/license/mit">MIT</a>. Content:{" "}
            <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">
              CC BY-NC-SA <span class="data">4.0</span>
            </a>. Third-party data keeps its own licence, named in each Source note.
          </p>
          <p>
            Course sequence informed by{" "}
            <a href="https://ocw.mit.edu/courses/5-12-organic-chemistry-i-spring-2003/">
              MIT OpenCourseWare <span class="data">5.12</span>
            </a>{" "}
            and <a href="https://chem.libretexts.org/">LibreTexts</a>.
          </p>
          <nav aria-label="Site">
            <a href="/about">About</a>
            <a href="/privacy">Privacy</a>
            <a href={suggestProblemHref()}>Suggest a Problem</a>
          </nav>
        </footer>
      )
    }
  </body>
</html>
